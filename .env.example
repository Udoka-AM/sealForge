# Copy to .env and fill in. Never commit real values.

# --- Coordinator (crates/sealforge-coordinator) ---
DATABASE_URL=postgres://sealforge:sealforge@localhost:5432/sealforge
SF_LISTEN_ADDR=0.0.0.0:8080
SF_NETWORK=testnet
SF_ZAINO_URL=http://localhost:8137
# 32+ random bytes, used by pgcrypto for encrypted columns
SF_DATA_KEY=
SF_REFUNDS_PAUSED=false
# Comma-separated organiser invite codes (the hosted instance is invite-only)
SF_INVITE_CODES=
# Dev only: fake chain height until the scanner (task 2.5) tracks the real tip
SF_DEV_CHAIN_HEIGHT=
# Default protocol fee in basis points of the clearing proceeds: 0 = no fee,
# or 500 to 1500 (5% to 15%). Each auction records the rate in force when it
# is created; the admin can set an auction's own rate before it opens.
SF_FEE_BPS=0
# Shielded unified address that receives the fee. Required when SF_FEE_BPS > 0.
SF_FEE_UA=
# Bearer token (32+ characters) for the admin endpoints, e.g. setting an
# auction's fee rate. Leave empty to turn them off. Generate: openssl rand -hex 32
SF_ADMIN_TOKEN=
RUST_LOG=info

# --- CLI ---
SF_COORDINATOR_URL=http://localhost:8080

# --- Web (apps/web) ---
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8080
# gRPC-web endpoint (Envoy in front of Zaino) used by WebZjs in the browser
NEXT_PUBLIC_ZAINO_GRPC_WEB_URL=http://localhost:8081
NEXT_PUBLIC_EVM_RPC_URL=
NEXT_PUBLIC_WC_PROJECT_ID=
# Server-only. NEAR Intents 1Click JWT (never expose to the browser)
ONECLICK_JWT=

# --- Infra (infra/docker-compose.yml) ---
POSTGRES_PASSWORD=sealforge
ZEBRA_NETWORK=Testnet
ZEBRA_IMAGE=zfnd/zebra:latest
# Pin in task 1.3 once an NU7-capable Zaino release is chosen
ZAINO_IMAGE=
SF_IMAGE_TAG=latest

# Default gRPC-web lightwallet endpoint offered on the Audit page (browser rescan).
LIGHTWALLETD_GRPCWEB=http://localhost:8081
