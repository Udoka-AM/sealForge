# Copy to .env and fill in. Never commit real values.

# --- Coordinator (crates/sealforge-coordinator) ---
DATABASE_URL=postgres://sealforge:sealforge@localhost:5432/sealforge
SF_LISTEN_ADDR=0.0.0.0:8080
SF_NETWORK=testnet
SF_ZAINO_URL=http://localhost:8137
# 32+ random bytes, used by pgcrypto for encrypted columns
SF_DATA_KEY=
SF_REFUNDS_PAUSED=false
RUST_LOG=info

# --- CLI ---
SF_COORDINATOR_URL=http://localhost:8080

# --- Web (apps/web) ---
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8080
# gRPC-web endpoint (Envoy in front of Zaino) used by WebZjs in the browser
NEXT_PUBLIC_ZAINO_GRPC_WEB_URL=http://localhost:8081
NEXT_PUBLIC_EVM_RPC_URL=
NEXT_PUBLIC_WC_PROJECT_ID=
# Server-only. NEAR Intents 1Click JWT (never expose to the browser)
ONECLICK_JWT=

# --- Infra (infra/docker-compose.yml) ---
POSTGRES_PASSWORD=sealforge
ZEBRA_NETWORK=Testnet
ZEBRA_IMAGE=zfnd/zebra:latest
# Pin in task 1.3 once an NU7-capable Zaino release is chosen
ZAINO_IMAGE=
SF_IMAGE_TAG=latest
